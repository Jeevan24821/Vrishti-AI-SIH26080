{
  "expo": {
    "name": "VRISHTI AI",
    "slug": "vrishti-ai",
    "owner": "monieshreddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#030712",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.vrishtiai.operations",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VRISHTI AI uses your location to show local rainfall and warning alerts for your district."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030712"
      },
      "package": "org.vrishtiai.operations",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a8462a5c-b2c5-4a8e-923d-eae062d10a39"
      }
    }
  }
}
