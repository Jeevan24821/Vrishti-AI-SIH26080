<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta x:xmptk="Adobe XMP Core 4.2.1-c043 52.372728, 2009/01/18-15:08:04" xmlns:x="adobe:ns:meta/">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Probabilistic rainfall thresholds for landslide occurrence using a Bayesian approach</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>M. Berti</rdf:li>
               <rdf:li>M. L. V. Martina</rdf:li>
               <rdf:li>S. Franceschini</rdf:li>
               <rdf:li>S. Pignone</rdf:li>
               <rdf:li>A. Simoni</rdf:li>
               <rdf:li>M. Pizziolo</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">1826 Hydrology: Geomorphology: hillslope (1625); 4302 Natural Hazards: Geological (0742, 4564, 7212, 7280, 8419, 8425, 8426, 8428, 8488); 4307 Natural Hazards: Methods (0500, 3200, 4400); 4317 Natural Hazards: Precursors</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Bayes theorem</rdf:li>
               <rdf:li>landslides</rdf:li>
